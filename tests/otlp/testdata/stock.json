            {"attributes": [{"key": "cpu", "value": {"stringValue": "cpu0"}}, {"key": "state", "value": {"stringValue": "wait"}}], "startTimeUnixNano": "1699999900000000000", "timeUnixNano": "1700000010000000000", "asDouble": 0},
            {"attributes": [{"key": "cpu", "value": {"stringValue": "cpu0"}}, {"key": "state", "value": {"stringValue": "nice"}}], "startTimeUnixNano": "1699999900000000000", "timeUnixNano": "1700000010000000000", "asDouble": 0},
            {"attributes": [{"key": "cpu", "value": {"stringValue": "cpu0"}}, {"key": "state", "value": {"stringValue": "interrupt"}}], "startTimeUnixNano": "1699999900000000000", "timeUnixNano": "1700000010000000000", "asDouble": 0},
            {"attributes": [{"key": "cpu", "value": {"stringValue": "cpu0"}}, {"key": "state", "value": {"stringValue": "softirq"}}], "startTimeUnixNano": "1699999900000000000", "timeUnixNano": "1700000010000000000", "asDouble": 0},
